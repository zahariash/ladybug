-DATASET CSV empty
--

-CASE ScanPredicatesBeforeStrings
-STATEMENT CALL threads=1;
---- ok
-STATEMENT CREATE NODE TABLE P(id INT64, k INT64, x INT64, y INT64, d DECIMAL(18,2), s STRING, PRIMARY KEY(id));
---- ok
-STATEMENT CREATE REL TABLE R(FROM P TO P, w INT64, note STRING);
---- ok
-STATEMENT UNWIND range(0, 4095) AS i CREATE (:P {id: i, k: CASE WHEN i IN [3, 5, 2048, 2055] THEN 1 ELSE 0 END, x: CASE WHEN i = 0 OR i = 2049 THEN 0 ELSE 1 END, y: CASE WHEN i % 5 = 0 THEN NULL ELSE i % 100 END, d: CAST(i % 10 AS DECIMAL(18,2)), s: 'v' + string(i)});
---- ok
-STATEMENT MATCH (a:P), (b:P) WHERE a.id = 1 AND b.id % 3 = 0 CREATE (a)-[:R {w: b.id % 50, note: 'n' + string(b.id)}]->(b);
---- ok
-STATEMENT MATCH (n:P) WHERE n.k = 1 RETURN count(n.s), sum(n.id);
---- 1
4|4111
-STATEMENT MATCH (n:P) WHERE n.x > 0 RETURN count(n.s), sum(n.id);
---- 1
4094|8384511
-STATEMENT MATCH (n:P) WHERE n.y = 7 RETURN count(n.s), min(n.s), max(n.s);
---- 1
41|v1007|v907
-STATEMENT MATCH (n:P) WHERE n.y <> 7 RETURN count(n.s), sum(n.id);
---- 1
3235|6625323
-STATEMENT MATCH (n:P) WHERE n.y IS NULL RETURN count(n.s), sum(n.id);
---- 1
820|1678950
-STATEMENT MATCH (n:P) WHERE n.y > 95 AND n.x = 1 RETURN count(n.s), sum(n.id);
---- 1
160|327600
-STATEMENT MATCH (n:P) WHERE CAST(n.d AS INT64) = 3 RETURN count(n.s);
---- 1
410
-STATEMENT MATCH (a:P)-[e:R]->(b:P) WHERE a.id = 1 AND e.w = 6 RETURN count(e.note), min(e.note), max(e.note);
---- 1
28|n1056|n906
