-CASE ScanPredicatesBeforeStringsTypesAndUpdates
-STATEMENT CALL threads=1;
---- ok
-STATEMENT CREATE NODE TABLE Q(id INT64, f DOUBLE, b BOOL, s STRING, PRIMARY KEY(id));
---- ok
-STATEMENT UNWIND range(0, 2999) AS i CREATE (:Q {id: i, f: CAST(i AS DOUBLE) * 0.5, b: i % 4 = 0, s: 'q' + string(i)});
---- ok
-STATEMENT CREATE NODE TABLE A(id INT64, v INT32, s STRING, PRIMARY KEY(id));
---- ok
-STATEMENT CREATE NODE TABLE B(id INT64, v INT64, s STRING, PRIMARY KEY(id));
---- ok
-STATEMENT UNWIND range(0, 99) AS i CREATE (:A {id: i, v: CAST(i % 10 AS INT32), s: 'a' + string(i)});
---- ok
-STATEMENT UNWIND range(0, 99) AS i CREATE (:B {id: i, v: i % 10, s: 'b' + string(i)});
---- ok
-STATEMENT MATCH (n:Q) WHERE n.f < 10.0 RETURN count(n.s), sum(n.id);
---- 1
20|190
-STATEMENT MATCH (n:Q) WHERE n.f >= 100.0 RETURN count(n.s), sum(n.id);
---- 1
2800|4478600
-STATEMENT MATCH (n:Q) WHERE n.b = true RETURN count(n.s), sum(n.id);
---- 1
750|1123500
-STATEMENT MATCH (n:A:B) WHERE n.v = 5 RETURN count(n.s), min(n.s), max(n.s);
---- 1
20|a15|b95
-STATEMENT MATCH (n:Q) WHERE n.id = 10 SET n.f = 1000.5;
---- ok
-STATEMENT MATCH (n:Q) WHERE n.f > 1000.0 RETURN count(n.s), sum(n.id);
---- 1
1000|2497510
-STATEMENT MATCH (n:Q) WHERE n.f < 10.0 RETURN count(n.s), sum(n.id);
---- 1
19|180
-STATEMENT CHECKPOINT;
---- ok
-STATEMENT MATCH (n:Q) WHERE n.f < 10.0 RETURN count(n.s), sum(n.id);
---- 1
19|180
-STATEMENT MATCH (n:Q) WHERE n.f >= 100.0 RETURN count(n.s), sum(n.id);
---- 1
2801|4478610
-STATEMENT MATCH (n:Q) WHERE n.b = true RETURN count(n.s), sum(n.id);
---- 1
750|1123500
-STATEMENT MATCH (n:A:B) WHERE n.v = 5 RETURN count(n.s), min(n.s), max(n.s);
---- 1
