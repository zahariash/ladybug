-DATASET CSV empty
--

-CASE LatePropertiesInAnyGraph
-SKIP_FSM_LEAK_CHECK
-LOG Properties of ANY-graph nodes live in a JSON column; each query returns what its single-part form returns
-STATEMENT CREATE GRAPH mygraph ANY
---- ok
-STATEMENT USE GRAPH mygraph
---- ok
-STATEMENT CREATE (:User {name: 'Alice', age: 30})-[:LivesIn]->(:City {name: 'Toronto', population: 3}), (:User {name: 'Bob', age: 40})-[:LivesIn]->(:City {name: 'Waterloo', population: 1})
---- ok
-STATEMENT MATCH (u:User) RETURN u.name ORDER BY u.age DESC LIMIT 2
-CHECK_ORDER
---- 2
Bob
Alice
-STATEMENT MATCH (u:User) WITH u ORDER BY u.age DESC LIMIT 2 RETURN u.name
-CHECK_ORDER
---- 2
Bob
Alice
-STATEMENT MATCH (u:User)-[:LivesIn]->(c:City) RETURN c.name, c.population, count(*) ORDER BY c.name
---- 2
Toronto|3|1
Waterloo|1|1
-STATEMENT MATCH (u:User)-[:LivesIn]->(c:City) UNWIND [1] AS x WITH c, count(*) AS n RETURN c.name, c.population, n ORDER BY c.name
---- 2
Toronto|3|1
Waterloo|1|1
-STATEMENT USE GRAPH main
---- ok
-STATEMENT DROP GRAPH mygraph
---- ok
