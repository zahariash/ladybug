-CASE LatePropertiesOfEmptiedOrOrderedNodes
-LOG Label pruning leaves b without a table after the rewrite: no rows
-STATEMENT MATCH (a:person)-[:studyAt]->(b:person) WITH b LIMIT 5 RETURN b.fName
---- 0
-STATEMENT MATCH (a:person)-[:studyAt]->(b:person) MATCH (b)-[:knows]->(c:person) WITH b, count(*) AS n RETURN b.fName, n
---- 0
-LOG An earlier ORDER BY keeps its order, also for the rows an aggregate in the RETURN reads
-STATEMENT MATCH (a:person) MATCH (a)-[:knows]->(b:person) WITH DISTINCT a ORDER BY a.age, a.ID LIMIT 2000 RETURN a.gender, collect(a.fName) AS names ORDER BY a.gender
-CHECK_ORDER
---- 2
1|[Elizabeth,Alice,Carol]
2|[Dan,Bob]
-LOG The RETURN sorts again without aggregating: the join is allowed, and rows are ordered by its keys
-STATEMENT MATCH (a:person) MATCH (a)-[:knows]->(b:person) WITH DISTINCT a ORDER BY a.age, a.ID LIMIT 2000 RETURN a.fName, a.gender ORDER BY a.gender, a.fName
-CHECK_ORDER
---- 5
Alice|1
Carol|1
Elizabeth|1
Bob|2
Dan|2
-STATEMENT MATCH (a:person)-[:knows]->(b:person) WITH DISTINCT a ORDER BY a.ID DESC LIMIT 5000 MATCH (a)-[:knows]->(c:person) WITH a LIMIT 2000 RETURN a.fName
-CHECK_ORDER
