-CASE LatePropertiesWithoutPrimaryKeyIndex
-STATEMENT CALL enable_default_hash_index=false;
---- ok
-STATEMENT CREATE NODE TABLE U (id INT64, name STRING, PRIMARY KEY(id));
---- ok
-STATEMENT UNWIND range(0, 4) AS i CREATE (:U {id: i, name: 'n' + cast(i AS STRING)});
---- ok
-STATEMENT MATCH (u:U) WITH u ORDER BY u.id DESC LIMIT 2 RETURN u.name
-CHECK_ORDER
---- 2
n4
n3
-STATEMENT CALL enable_default_hash_index=true;
---- ok

