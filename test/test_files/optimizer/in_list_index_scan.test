n2
n4
-STATEMENT CREATE NODE TABLE U (ID UUID, v INT64, PRIMARY KEY(ID));
---- ok
-STATEMENT CREATE (:U {ID: UUID('a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11'), v: 1}), (:U {ID: UUID('a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a12'), v: 2});
---- ok
-STATEMENT MATCH (u:U) WHERE u.ID = 'a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11' OR u.ID = 'a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a13' RETURN u.v;
