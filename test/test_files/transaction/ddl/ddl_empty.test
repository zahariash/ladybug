-CASE WriteNodeRowsInTransactionAfterDrop
-STATEMENT CREATE NODE TABLE P(id INT64 PRIMARY KEY, a INT64, b INT64, c INT64);
---- ok
-STATEMENT CREATE (:P {id: 1, a: 11, b: 12, c: 13});
---- ok
-STATEMENT ALTER TABLE P DROP b;
---- ok
-STATEMENT BEGIN TRANSACTION;
---- ok
-STATEMENT CREATE (:P {id: 2, a: 21, c: 23});
---- ok
-STATEMENT MATCH (p:P) WHERE p.id = 2 SET p.c = 24;
---- ok
-STATEMENT MERGE (p:P {id: 3}) ON CREATE SET p.c = 33;
---- ok
-STATEMENT MATCH (p:P) WHERE p.c > 20 RETURN p.id, p.a, p.c ORDER BY p.id;
---- 2
2|21|24
3||33
-STATEMENT COMMIT;
---- ok
-STATEMENT MATCH (p:P) RETURN p.id, p.a, p.c ORDER BY p.id;
---- 3
1|11|13
2|21|24
3||33

