---- ok
-STATEMENT ALTER TABLE P ADD h STRUCT(x INT64, y STRING) DEFAULT {x: 7, y: 'z'};
---- ok
-STATEMENT ROLLBACK;
---- ok
-STATEMENT CREATE (:P {id: 2, a: 2});
---- ok
-STATEMENT ALTER TABLE P ADD e INT64 DEFAULT 5;
---- ok
